# MongoDB connection settings for Docker Compose
# When using docker-compose, the hostname for MongoDB is the service name `mongo`
MONGO_USERNAME=root
MONGO_PASSWORD=root
MONGO_HOST=mongo:27017
MONGO_DB=mpath

# App binding
APP_HOST=0.0.0.0
APP_PORT=8000

# Optional: protect API endpoints; when set, clients must send X-API-SECRET header
# API_SECRET=change_me

# Enable or disable the GraphQL playground (default: true)
GRAPHQL_PLAYGROUND=true

# Optional: enable auto-reload in development (mount source and uncomment volumes in compose)
# UVICORN_RELOAD=true

# Force all requests to use HTTPS (redirects HTTP to HTTPS)
# Note: If FORCE_HTTPS is true, you MUST also provide SSL_CERTFILE and SSL_KEYFILE
# for Uvicorn to handle the HTTPS connection, or use a reverse proxy.
FORCE_HTTPS=false

# SSL Certificate and Key files for HTTPS support
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem
